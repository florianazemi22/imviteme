# Copy to .env for docker compose. Values here are development defaults and
# are safe to commit precisely because they are worthless outside localhost.
#
#   cp .env.example .env

# --- ports (change if something already owns one) ---------------------------
LANDING_PORT=8080
WEB_PORT=8000
OG_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- app --------------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
NODE_ENV=development

# --- postgres ---------------------------------------------------------------
POSTGRES_DB=imvite
POSTGRES_USER=imvite
POSTGRES_PASSWORD=imvite
